---
interface Props {
    href: string;
    label: string;
    class?: string;
}

const { href, label, class: className } = Astro.props;
const baseClass = 'text-[10px] sm:text-xs md:text-sm uppercase tracking-wide transition-all ease-in duration-150 hover:scale-110 hover:opacity-80';
---

<a
    class:list={[baseClass, className]}
    href={href}
>
    {label}
</a>
