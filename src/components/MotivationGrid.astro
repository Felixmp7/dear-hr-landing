---
interface Props {
    title: string;
    imageSrc: string;
    imageAlt: string;
    imageToRight?: boolean;
}

const { imageAlt, imageSrc, title, imageToRight = true } = Astro.props;

const gridOrder = imageToRight ? 'order-0' : 'order-1';
---

<div class="grid grid-cols-1 lg:grid-cols-2 items-center gap-20">
    <div class={gridOrder}>
        <h3 class="text-lg sm:text-xl md:text-2xl font-semibold mb-5 md:mb-10">
            {title}
        </h3>
        <slot />
    </div>
    <img
        src={imageSrc}
        alt={imageAlt}
    />
</div>
