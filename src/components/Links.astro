---
import { getLangFromUrl, useTranslations } from '@/i18n/i18n.utils';
import Link from './Link.astro';

interface Props {
    class?: string;
    showLanguagesPicker?: boolean;
}

const { class: className, showLanguagesPicker = false } = Astro.props;
const BASE_CLASS = 'flex flex-row w-full items-center justify-center gap-x-14';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<ul class:list={[BASE_CLASS, className]}>
    <Link
        href="#"
        label="Dear HR"
        class="mr-auto"
    />
    <Link
        label={t('nav.features')}
        href="#features"
    />
    <Link
        label={t('nav.benefits')}
        href="#benefits"
    />
    <Link
        label={t('nav.motivation')}
        href="#motivation"
    />
    {
        showLanguagesPicker && (
            <li class="ml-auto px-4 py-2 text-sm font-light text-fuscous-gray-400">
                <a
                    href="/"
                    data-active={lang === 'es'}
                    class="data-[active]:font-bold mr-1"
                >
                    {t('nav.languages.es')}
                </a>
                |
                <a
                    href="/en"
                    data-active={lang === 'en'}
                    class="data-[active]:font-bold ml-1"
                >
                    {t('nav.languages.en')}
                </a>
            </li>
        )
    }
</ul>
