---
import { getLangFromUrl, useTranslations } from '@/i18n/i18n.utils';
import Link from './Link.astro';

interface Props {
    class?: string;
    showLanguagesPicker?: boolean;
}

const { class: className, showLanguagesPicker = false } = Astro.props;
const BASE_CLASS = 'flex  w-full items-center gap-x-6 md:gap-x-14';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<ul class:list={[BASE_CLASS, className]}>
    <li class="mr-auto min-w-fit inline-flex flex-col items-center">
        <Link
            href="#"
            label="Dear HR"
        />
        {
            showLanguagesPicker && (
                <div class="text-[10px] sm:text-xs font-light text-fuscous-gray-400 min-w-fit">
                    <a
                        href="/"
                        data-active={lang === 'es' ? 'true' : 'false'}
                        class="data-[active=true]:font-bold mr-1"
                    >
                        {t('nav.languages.es')}
                    </a>
                    |
                    <a
                        href="/en"
                        data-active={lang === 'en' ? 'true' : 'false'}
                        class="data-[active=true]:font-bold ml-1"
                    >
                        {t('nav.languages.en')}
                    </a>
                </div>
            )
        }
    </li>
    <li>
        <Link
            label={t('nav.features')}
            href="#features"
        />
    </li>
    <li>
        <Link
            label={t('nav.benefits')}
            href="#benefits"
        />
    </li>
    <li>
        <Link
            label={t('nav.motivation')}
            href="#motivation"
        />
    </li>
</ul>
