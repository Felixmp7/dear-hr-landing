---
import { getLangFromUrl, useTranslations } from '@/i18n/i18n.utils';
import Link from './Link.astro';

interface Props {
    class?: string;
    showLanguagesPicker?: boolean;
}

const { class: className, showLanguagesPicker = false } = Astro.props;
const BASE_CLASS = 'flex flex-row w-full justify-center gap-x-14';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<ul class:list={[BASE_CLASS, className]}>
    <Link
        href="#"
        label="Dear HR"
    />
    <Link
        label={t('nav.features')}
        href="#features"
    />
    <Link
        label={t('nav.benefits')}
        href="#benefits"
    />
    <Link
        label={t('nav.motivation')}
        href="#motivation"
    />
    {
        showLanguagesPicker && (
            <>
                <Link
                    label={t('nav.languages.es')}
                    href="/"
                />
                <Link
                    label={t('nav.languages.en')}
                    href="/en"
                />
            </>
        )
    }
</ul>
