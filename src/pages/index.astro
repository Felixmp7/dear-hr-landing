---
import Layout from '@/layouts/Layout.astro';
import Benefits from '@/sections/Benefits.astro';
import BentoProduct from '@/sections/BentoProduct.astro';
import Footer from '@/sections/Footer.astro';
import Header from '@/sections/Header.astro';
import Hero from '@/sections/Hero.astro';
import Motivation from '@/sections/Motivation.astro';
import { getLandingData } from '@/services/data.service';

const data = getLandingData();
---

<Layout meta={data.meta}>
    <Header
        logo={data.logo}
        links={data.links}
    />
    <main class="container mx-auto">
        <Hero data={data.heroData} />
        <BentoProduct />
        <Benefits data={data.advantagesData} />
        <Motivation data={data.motivationData} />
    </main>
    <hr />
    <Footer
        logo={data.logo}
        links={data.links}
    />
</Layout>
