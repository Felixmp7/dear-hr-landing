---
import Background from '@/components/Background.astro';
import type { Meta } from '@/models/landing.interface';
import '@fontsource-variable/rubik';

interface Props {
    meta: Meta;
}

const { meta } = Astro.props;

const ldJson = JSON.stringify(meta.ldJson);
---

<!doctype html>
<html
    class="scrollbar-thin scrollbar-thumb-fuscous-gray-300 scrollbar-track-transparent scroll-smooth"
    lang={meta.lang ?? 'es'}
>
    <head>
        <meta charset={meta.charset ?? 'UTF-8'} />
        <title>{meta.title}</title>
        <meta
            name="description"
            content={meta.description}
        />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1.0"
        />
        <link
            rel="icon"
            type="image/svg+xml"
            href="/favicon.svg"
        />
        <link
            rel="canonical"
            href={import.meta.env.SITE}
        />
        <script
            type="application/ld+json"
            set:html={ldJson}
        />
    </head>
    <body class="bg-white">
        <Background />
        <slot />
    </body>
</html>

<style is:global>
    body {
        font-family: 'Rubik Variable', Menlo, Monaco, monospace;
    }
    section {
        margin-bottom: 10rem;
    }
</style>
