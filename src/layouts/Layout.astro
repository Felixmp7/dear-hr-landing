---
import Background from '@/components/Background.astro';
import { useTranslations } from '@/hooks/useTranslation';
import { getLangFromUrl, getMetaLdJson } from '@/i18n/i18n.utils';
import '@fontsource-variable/rubik';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const ldJson = getMetaLdJson(lang);
---

<!doctype html>
<html
    class="scrollbar-thin scrollbar-thumb-fuscous-gray-300 scrollbar-track-transparent scroll-smooth"
    lang={lang}
>
    <head>
        <meta charset="UTF-8" />
        <title>Dear HR</title>
        <meta
            name="description"
            content={t('meta.description')}
        />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1.0"
        />
        <link
            rel="icon"
            type="image/svg+xml"
            href="assets/svg/dear-hr-logo.svg"
        />
        <link
            rel="canonical"
            href={import.meta.env.SITE}
        />
        <script
            is:inline
            type="application/ld+json"
            set:html={ldJson}
        />
    </head>
    <body class="bg-white text-fuscous-gray-800">
        <Background />
        <slot />
    </body>
</html>

<style is:global>
    body {
        font-family: 'Rubik Variable', Menlo, Monaco, monospace;
    }
    section {
        margin-bottom: 10rem;
    }

    @media screen and (max-width: 640px) {
        section {
            margin-bottom:0;
        }
    }
</style>
