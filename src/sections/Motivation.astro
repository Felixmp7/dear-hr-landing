---
import { getEntry } from 'astro:content';

import MotivationGrid from '@/components/MotivationGrid.astro';
import SectionTitle from '@/components/SectionTitle.astro';
import { getLangFromUrl } from '@/i18n/i18n.utils';

const lang = getLangFromUrl(Astro.url);
const motivationCollection = await getEntry('motivation', `${lang}/motivation`);
---

<section
    id="motivation"
    class="mb-20 md:mb-40 flex flex-col gap-y-6 md:gap-y-16 pt-36 sm:pt-28 text-base md:text-lg"
>
    <SectionTitle>
        {motivationCollection?.data.title}
    </SectionTitle>
    <p class="md:text-center mb-10">
        {motivationCollection?.data.description}
    </p>
    <MotivationGrid
        title={motivationCollection!.data.ptoFeature.title}
        imageSrc="assets/svg/excel.svg"
        imageAlt="motivation draw"
    >
        <ul class="list-inside list-disc space-y-4">
            {
                motivationCollection?.data.ptoFeature.items.map((item) => (
                    <li>
                        <strong>{item.title}:</strong>
                        <span>{item.description}</span>
                    </li>
                ))
            }
        </ul>
    </MotivationGrid>
    <MotivationGrid
        title={motivationCollection!.data.teamCultureFeature.title}
        imageSrc="assets/svg/team.svg"
        imageAlt="motivation draw"
        imageToRight={false}
    >
        <div class="space-y-4">
            <p>
                {motivationCollection?.data.teamCultureFeature.paragraph1}
            </p>
            <p>
                {motivationCollection?.data.teamCultureFeature.paragraph2}
            </p>
            <p>
                {motivationCollection?.data.teamCultureFeature.paragraph3}
            </p>
            <p>
                {motivationCollection?.data.teamCultureFeature.paragraph4}
            </p>
            <p>
                {motivationCollection?.data.finalParagraph}
            </p>
        </div>
    </MotivationGrid>
</section>
