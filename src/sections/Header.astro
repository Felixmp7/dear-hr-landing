---
import Links from '@/components/Links.astro';
import type { Link } from '@/models/landing.interface';

interface Props {
    logo: string;
    links: Link[];
}

const { logo, links } = Astro.props;
---

<header
    id="navbar"
    class="w-full transition duration-300 top-0 justify-center fixed h-20 z-50 flex"
>
    <nav
        aria-label="Main Navigation"
        class="flex flex-row items-center w-3/4 relative"
    >
        <a
            class="text-nowrap absolute left-0"
            href="#"
        >
            {logo}
        </a>
        <Links links={links} />
    </nav>
</header>

<style>
    #navbar {
        border-bottom-width: 0.5px;
        border-bottom-color: transparent;
        animation: blurOnScroll linear both;
        animation-timeline: scroll();
        animation-range: 0 500px;
    }

    @keyframes blurOnScroll {
        to {
            border-bottom-color: #6b728033;
            background-color: #ffffff;
            backdrop-filter: blur(20px);
        }
    }
</style>
