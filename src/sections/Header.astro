---
import Links from '@/components/Links.astro';
---

<header
    id="navbar"
    class="w-full transition duration-300 top-0 fixed z-50"
>
    <nav
        aria-label="Main Navigation"
        class="flex flex-row items-center container mx-auto p-5"
    >
        <Links showLanguagesPicker />
    </nav>
</header>

<style>
    #navbar {
        border-bottom-width: 0.5px;
        border-bottom-color: transparent;
        animation: blurOnScroll linear both;
        animation-timeline: scroll();
        animation-range: 0 500px;
    }

    @keyframes blurOnScroll {
        to {
            border-bottom-color: #6b728033;
            background-color: #ffffff;
            backdrop-filter: blur(20px);
        }
    }
</style>
