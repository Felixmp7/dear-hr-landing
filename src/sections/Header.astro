---
import Link from '@/components/Link.astro';
import { useTranslations } from '@/hooks/useTranslation';
import { getLangFromUrl } from '@/i18n/i18n.utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<header
    id="navbar"
    class="w-full transition duration-300 top-0 fixed z-50 p-5"
>
    <nav
        aria-label="Main Navigation"
        class="container mx-auto"
    >
        <ul class="flex w-full pb-12 xs:pb-0 justify-center xs:justify-normal items-center gap-x-6 md:gap-x-14 relative">
            <li class="absolute top-12 mr-auto xs:static min-w-fit inline-flex flex-col items-center">
                <Link
                    href="#"
                    label="Dear HR"
                />
                <div class="text-[10px] sm:text-xs font-light text-fuscous-gray-400 min-w-fit">
                    <a
                        href="/"
                        data-active={lang === 'es' ? 'true' : 'false'}
                        class="data-[active=true]:font-bold mr-1"
                    >
                        {t('nav.languages.es')}
                    </a>
                    |
                    <a
                        href="/en"
                        data-active={lang === 'en' ? 'true' : 'false'}
                        class="data-[active=true]:font-bold ml-1"
                    >
                        {t('nav.languages.en')}
                    </a>
                </div>
            </li>
            <li>
                <Link
                    label={t('nav.features')}
                    href="#features"
                />
            </li>
            <li>
                <Link
                    label={t('nav.benefits')}
                    href="#benefits"
                />
            </li>
            <li>
                <Link
                    label={t('nav.motivation')}
                    href="#motivation"
                />
            </li>
        </ul>
    </nav>
</header>

<style>
    #navbar {
        border-bottom-width: 0.5px;
        border-bottom-color: transparent;
        animation: blurOnScroll linear both;
        animation-timeline: scroll();
        animation-range: 0 500px;
    }

    @keyframes blurOnScroll {
        to {
            border-bottom-color: #6b728033;
            background-color: #ffffff;
            backdrop-filter: blur(20px);
        }
    }
</style>
