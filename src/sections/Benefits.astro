---
import { getEntry } from 'astro:content';

import SectionTitle from '@/components/SectionTitle.astro';
import SideBySide from '@/components/SideBySide.astro';
import { getLangFromUrl } from '@/i18n/i18n.utils';

const lang = getLangFromUrl(Astro.url);
const benefitsCollection = await getEntry('benefits', `${lang}/benefits`);
---

<section
    id="benefits"
    class="flex flex-col mb-20 gap-y-28 pt-28"
>
    <SectionTitle>
        {benefitsCollection.data.title}
    </SectionTitle>
    <main>
        <SideBySide
            data={benefitsCollection.data.benefits[0]}
            iconClassName="bg-primary-500"
        />
        <SideBySide
            data={benefitsCollection.data.benefits[1]}
            iconClassName="bg-fifthly-400"
            reversed
        />
    </main>
</section>
