---
import SendIcon from '@/components/icons/SendIcon.astro';
import { getLangFromUrl, useTranslations } from '@/i18n/i18n.utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="flex justify-center pt-48 h-screen">
    <div class="md:w-1/2">
        <h1 class="text-4xl text-center font-semibold md:text-6xl">
            {t('hero.title')}
            <span class="text-tertiary-500"> {t('hero.highlightedTitle')} </span>
        </h1>
        <h2 class="mt-10 text-lg text-center opacity-80 md:text-2xl">
            {t('hero.subTitle')}
        </h2>
        <div class="flex flex-col gap-1 items-center text-gray-500 mt-5">
            <span>{t('hero.waitListQuestion')}</span>
            <span>{t('hero.waitListMessage')}</span>
            <div class="flex gap-4 items-center mt-5">
                <input
                    type="email"
                    class="border border-black p-2 rounded-md mx-auto w-80"
                    placeholder={t('hero.waitListPlaceholder')}
                />
                <button class="flex items-center justify-center bg-tertiary-500 text-white rounded-md px-4 py-2 gap-2">
                    <span>{t('hero.waitListButton')}</span>
                    <SendIcon
                        width={20}
                        height={20}
                    />
                </button>
            </div>
        </div>
        <div class="flex justify-center">
            <a
                class="flex justify-center items-center animate-bounce border-2 border-transparent bg-tertiary-500 text-white rounded-full w-14 h-14 mt-32 hover:bg-white hover:text-tertiary-500 hover:border-tertiary-500 transition"
                href="#features"
                title="arrow down icon"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="1.5"
                    stroke="currentColor"
                    class="w-8 h-8"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M19.5 13.5 12 21m0 0-7.5-7.5M12 21V3"
                    ></path>
                </svg>
            </a>
        </div>
    </div>
</section>

<style>
    @keyframes fadeIn {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }

    #hero-section {
        opacity: 0;
        animation: fadeIn 0.8s ease-in-out forwards;
    }
</style>
