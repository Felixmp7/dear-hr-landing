---
import { actions } from 'astro:actions';

import SendIcon from '@/components/icons/SendIcon.astro';
import { getLangFromUrl, useTranslations } from '@/i18n/i18n.utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="flex justify-center pt-48 h-screen">
    <div class="w-full md:w-5/6 lg:w-1/2">
        <h1 class="text-3xl sm:text-4xl text-center font-semibold md:text-6xl">
            {t('hero.title')}
            <span class="text-tertiary-500"> {t('hero.highlightedTitle')} </span>
        </h1>
        <h2 class="mt-10 text-lg text-center opacity-80 md:text-2xl">
            {t('hero.subTitle')}
        </h2>
        <div class="flex flex-col gap-1 text-center items-center text-gray-500 mt-10 text-balance">
            <span class="text-sm md:text-base">{t('hero.waitListQuestion')}</span>
            <span class="text-sm md:text-base">{t('hero.waitListMessage')}</span>
            <form
                class="flex flex-col sm:flex-row gap-4 items-center mt-5 text-sm sm:text-base w-full"
                method="POST"
                action={actions.send}
            >
                <input
                    id="email"
                    name="email"
                    type="email"
                    class="border border-fuscous-gray-200 p-2 rounded-md mx-auto w-full"
                    placeholder={t('hero.waitListPlaceholder')}
                />
                <button
                    type="submit"
                    class="w-full sm:w-auto flex items-center justify-center bg-tertiary-500 text-white rounded-md px-4 py-2 gap-2"
                >
                    <span>{t('hero.waitListButton')}</span>
                    <SendIcon
                        width={20}
                        height={20}
                    />
                </button>
            </form>
        </div>
        <div class="flex justify-center mt-10 md:mt-20">
            <a
                class="flex justify-center items-center animate-bounce border-2 border-transparent bg-tertiary-500 text-white rounded-full w-14 h-14 hover:bg-white hover:text-tertiary-500 hover:border-tertiary-500 transition"
                href="#features"
                title="arrow down icon"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="1.5"
                    stroke="currentColor"
                    class="w-8 h-8"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M19.5 13.5 12 21m0 0-7.5-7.5M12 21V3"
                    ></path>
                </svg>
            </a>
        </div>
    </div>
</section>

<script>
    const form = document.querySelector('form');
    const emailInput = document.querySelector('input[name="email"]') as HTMLInputElement;
    const submitButton = document.querySelector('button[type="submit"]') as HTMLButtonElement;

    form?.addEventListener('submit', (e) => {
        e.preventDefault();

        if (!emailInput?.value) return;
        console.log(submitButton);

        submitButton.disabled = true;
        setTimeout(() => {
            alert('Correo enviado correctamente');
            submitButton.disabled = false;
        }, 10_000);

        // fetch(form.action, {
        //     method: 'POST',
        //     body: new FormData(form),
        // })
        //     .then((res) => res.json())
        //     .then(() => {
        //         alert('Correo enviado correctamente');
        //     })
        //     .catch((err) => {
        //         console.error(err);
        //         submitButton.disabled = false;
        //     });
    });
</script>

<style>
    @keyframes fadeIn {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }

    #hero-section {
        opacity: 0;
        animation: fadeIn 0.8s ease-in-out forwards;
    }
</style>
